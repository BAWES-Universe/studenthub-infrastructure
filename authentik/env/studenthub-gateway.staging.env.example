# StudentHub gateway — staging login configuration (SHU-50).
#
# Copy to a location OUTSIDE this repository, fill in the two secret values, and
# load it into the gateway service. `.env*` is gitignored; never commit a filled
# copy. This example file carries placeholders only and is checked by CI.
#
# The nine OIDC/login variables are ALL-OR-NOTHING. createRuntimeLoginFromEnv()
# returns undefined when none are set (login routes stay disabled) and THROWS
# when only some are set (the service fails to start). There is no partial mode.

# --- Secrets: fill in from the password manager, never from a chat or a ticket.
DATABASE_URL=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME

# --- Public configuration. These MUST match authentik/blueprints/studenthub-staging-oidc.yaml.
# Plain "studenthub" (not "-staging"): this IS StudentHub, hostname staging.studenthub.co.
# On release a second DNS record is added to the same box without reconfiguration (Khalid 2026-09-08).
OIDC_CLIENT_ID=studenthub

# Compared to the ID-token `iss` claim by exact string equality. The trailing
# slash is significant: Authentik issues this value with it.
# D1 (ratified 2026-09-08): existing production Authentik, no second IdP.
OIDC_ISSUER=https://auth.bawes.net/application/o/studenthub/

OIDC_AUTHORIZATION_URL=https://auth.bawes.net/application/o/authorize/
OIDC_TOKEN_URL=https://auth.bawes.net/application/o/token/
OIDC_JWKS_URL=https://auth.bawes.net/application/o/studenthub/jwks/

# Pathname must be exactly /login/callback — the gateway rejects anything else
# at startup — and must match the provider's strict redirect_uris entry.
# D2 (ratified 2026-09-08): staging-named hostname on the StudentHub box.
OIDC_CALLBACK_URL=https://staging.studenthub.co/login/callback

# Comma-separated exact HTTPS URLs. A return_to outside this list is refused.
# The gateway serves no static frontend in this package: after login the
# browser is redirected to the gateway's own /profile route (own-profile-only
# enforced server-side via person_id). Earlier drafts used /app — no such
# route exists; corrected to the real post-login destination.
LOGIN_ALLOWED_RETURN_URLS=https://staging.studenthub.co/profile
